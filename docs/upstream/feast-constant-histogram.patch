+def numeric_histogram(values: np.ndarray, bins: int) -> Dict[str, Any]:
+    """Build the histogram dict for non-null numeric values.
+
+    A constant column becomes a single zero-width bin ``[v, v]`` holding every
+    value, the same shape the SQL backends (DuckDB, Postgres, Snowflake, ...)
+    store, instead of numpy's ``bins`` bins spread over ``[v - 0.5, v + 0.5]``.
+    """
+    lo, hi = float(values.min()), float(values.max())
+    if lo == hi:
+        return {"bins": [lo, hi], "counts": [int(len(values))], "bin_width": 0.0}
+    counts, bin_edges = np.histogram(values, bins=bins)
+    return {
+        "bins": bin_edges.tolist(),
+        "counts": counts.tolist(),
+        "bin_width": float(bin_edges[1] - bin_edges[0]),
+    }
+
